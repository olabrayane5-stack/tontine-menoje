# Mode API (optionnel)
# Renseigner cette variable bascule le front en mode API : connexion serveur,
# jetons Bearer et données MySQL. Sans elle, l'application reste en mode
# démonstration (localStorage). Aucun slash final.
# Exemple local : VITE_API_URL="http://localhost:8080/api"
# Exemple prod  : VITE_API_URL="https://VOTRE-SOUS-DOMAINE.infinityfreeapp.com/api"
VITE_API_URL=""

# GEMINI_API_KEY: non utilisée par l'application actuelle.
# L'assistant repose sur des règles locales (src/utils/tontineUtils.ts).
# Cette clé est réservée à une future API serveur (voir src/components/TechGuideModal.tsx).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL d'hébergement de l'applet.
# Non lue par le front actuel ; utile pour des liens absolus.
APP_URL="MY_APP_URL"
