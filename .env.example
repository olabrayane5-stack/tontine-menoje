# GEMINI_API_KEY: non utilisé par l'application actuelle.
# L'assistant repose sur des règles locales (src/utils/tontineUtils.ts).
# Cette clé est réservée à une future API serveur (voir src/components/TechGuideModal.tsx).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL d'hébergement de l'applet.
# Non lue par le front actuel ; utile pour une future API / des liens absolus.
APP_URL="MY_APP_URL"
